# Copy to .env (gitignored) and fill in the values you want to use.
#
# The api degrades gracefully when a credential is missing — see the notes
# on each section for what happens in that case.

# Server port. Defaults to 3000 if unset. The Vite dev server proxies /api
# to this port — keep them in sync if you change it.
# PORT=3130

# ----------------------------------------------------------------------------
# LLM enrichment (Gemini)
# ----------------------------------------------------------------------------
# Google AI Studio API key. When set, the URL flow runs the enricher prompt
# against Gemini to produce a richer profile (description, kind, keyPoints).
# When unset, all flows use deterministic passthrough — still works, just
# less informed agent files.
# Get a free key: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# Optional override for the LLM model. Defaults to gemini-2.5-flash.
# LLM_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------------------
# GitHub repo scanner
# ----------------------------------------------------------------------------
# Personal access token (or GitHub App install token). Authenticated GitHub
# API access is 5000 req/hr; unauthenticated is 60 req/hr (effectively a
# rate limit for any real use). Create one at:
#   https://github.com/settings/tokens   (public_repo scope is enough)
# GITHUB_TOKEN=

# ----------------------------------------------------------------------------
# MongoDB (optional — persists usage, users, feedback)
# ----------------------------------------------------------------------------
# When set, the api logs every generate event to the `usage` collection
# (7-day TTL), upserts signed-in users into `users`, and stores feedback in
# `feedback`. Required for the per-user rate limit and the anon-URL
# IP-bucket counter. When unset, the api still serves traffic — just with
# no persistent rate limit and no usage analytics.
# MONGODB_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/prmd-ai?retryWrites=true&w=majority

# Optional: force Node's c-ares resolver to use specific DNS servers when
# making the `mongodb+srv://` SRV lookup. Only needed on Windows dev boxes
# where the system DNS sometimes refuses SRV queries. Unset in prod —
# GCP's resolver handles SRV correctly.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ----------------------------------------------------------------------------
# Clerk auth (optional — enables signed-in URL flow + feedback widget)
# ----------------------------------------------------------------------------
# When set, repo URL scanning gets the 30/hr per-user bucket for signed-in
# users (vs 5/hr per IP for anon) and the post-generation feedback widget
# is enabled. When unset, the entire app runs in anon-only mode — URL flow
# is still open at 5/hr per IP, feedback widget hides, manual flow
# unaffected. This is the "path C" launch configuration.
#
# Free Clerk allows one production domain per app. To run prmd.ai with
# auth, you either pay Clerk Pro to add it as a satellite domain on your
# main app, or create a separate Clerk app for prmd.ai.
# CLERK_SECRET_KEY=

# Optional. Same publishable key the frontend uses. Some Clerk APIs prefer
# both keys configured server-side for token verification.
# CLERK_PUBLISHABLE_KEY=

# ----------------------------------------------------------------------------
# Pushover ops notifications (optional)
# ----------------------------------------------------------------------------
# When set, the api fires a Pushover notification for every feedback
# submission (👍 / 👎 with optional comment). Only useful when Clerk is
# also enabled, since feedback is auth-required. When unset, the api
# silently skips sending notifications.
# Get a token at https://pushover.net.
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
