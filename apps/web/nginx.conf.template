server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Cloud Run terminates TLS upstream — trust X-Forwarded-* and don't add
    # the port to absolute redirects.
    port_in_redirect off;
    absolute_redirect off;
    set $forwarded_scheme $scheme;
    if ($http_x_forwarded_proto) {
        set $forwarded_scheme $http_x_forwarded_proto;
    }
    real_ip_header X-Forwarded-For;
    set_real_ip_from 0.0.0.0/0;

    # Cloud Run service URLs need runtime DNS resolution; without an explicit
    # resolver nginx caches the first lookup at boot and never refreshes.
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/javascript application/json image/svg+xml;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # Health endpoint for Cloud Run probes.
    location = /health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # Cache hashed Vite assets aggressively.
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map|webp|avif)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # HTML must never be cached — Vite rebuilds the index per deploy.
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri /index.html;
    }

    # Proxy /api/* to the API Cloud Run service. ${API_URL} is templated in
    # by envsubst at container start (nginx:alpine's entrypoint handles this
    # automatically for files under /etc/nginx/templates).
    location /api/ {
        set $api_upstream "${API_URL}";
        proxy_pass $api_upstream$request_uri;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Authorization (Clerk JWT) must reach the API verbatim.
        proxy_pass_request_headers on;
        proxy_connect_timeout 30s;
        proxy_read_timeout 60s;
        proxy_send_timeout 30s;
    }

    # SPA fallback for everything else.
    location / {
        try_files $uri /index.html;
    }
}
