# Keep the Cloud Build context lean. Anything excluded here also means it
# can't be COPYd in the Dockerfile — keep this in sync with what the
# Dockerfiles actually need.

# Dependencies: reinstalled inside the build via `npm ci`.
node_modules
**/node_modules

# Build outputs: produced inside the build.
dist
**/dist
.vite

# Per-app prompd cache: regenerated by `prompd install` in the API build.
.prompd
**/.prompd

# Local dev / state.
.git
.gitignore
.github
.vscode
*.log
.env
.env.local
.env.development
.env.production
**/.env
**/.env.local
**/.env.development
**/.env.production

# Editor / OS noise.
.DS_Store
Thumbs.db

# Deployment configs aren't needed inside the image.
deployment/

# Dev-only ops scripts (e.g. clear-anon-usage). Run via tsx locally only;
# nothing in production should call them.
apps/api/scripts/
